{
    "name": "modernization-assessment-target-architecture",
    "description": "Consultor de opciones de modernización: a partir del discovery y el AS-IS, entrega restricciones del legado, patrones, escenarios comparados con una opción sugerida condicionada, decisiones abiertas (ADR) y validaciones previas (PoC), con servicios AWS verificados en la documentación oficial",
    "model": "claude-opus-5.5",
    "tools": [
        "@aws-knowledge",
        "read",
        "shell",
        "write"
    ],
    "includeMcpJson": false,
    "mcpServers": {
        "aws-knowledge": {
            "url": "https://knowledge-mcp.global.api.aws"
        }
    },
    "prompt": "file://./consultant-modernization-assets/prompts/modernization-assessment-target-architecture.md",
    "welcomeMessage": "Consultor de opciones de modernización listo. Entrego restricciones, patrones, escenarios y decisiones abiertas para que el equipo elija el camino.",
    "permissions": {
        "rules": [
            {
                "capability": "shell",
                "match": [
                    "find *",
                    "find",
                    "grep *",
                    "grep",
                    "ls *",
                    "ls",
                    "cat *",
                    "cat",
                    "wc *",
                    "wc",
                    "head *",
                    "head"
                ],
                "effect": "allow"
            },
            {
                "capability": "shell",
                "effect": "deny",
                "match": [
                    "*`*",
                    "*$(*",
                    "find * -exec*",
                    "find * -ok*",
                    "find * -delete*",
                    "find * -fprint*",
                    "find * -fls*",
                    "find -exec*",
                    "find -execdir*",
                    "find -ok*",
                    "find -okdir*",
                    "find -delete*",
                    "find -fprint*",
                    "find -fls*",
                    "* .. *",
                    "* ../*",
                    "*/../*",
                    "* ..",
                    "*/..",
                    "*/..'*",
                    "*/..\"*",
                    "*=../*",
                    "*'..*",
                    "*\"..*",
                    "*~*/.aws*",
                    "*/Users/*/.aws*",
                    "*/home/*/.aws*",
                    "*/root/.aws*",
                    "*~*/.ssh*",
                    "*/Users/*/.ssh*",
                    "*/home/*/.ssh*",
                    "*/root/.ssh*",
                    "*~*/.gnupg*",
                    "*/Users/*/.gnupg*",
                    "*/home/*/.gnupg*",
                    "*/root/.gnupg*",
                    "*~*/.kube*",
                    "*/Users/*/.kube*",
                    "*/home/*/.kube*",
                    "*/root/.kube*",
                    "*~*/.docker*",
                    "*/Users/*/.docker*",
                    "*/home/*/.docker*",
                    "*/root/.docker*",
                    "*~*/.azure*",
                    "*/Users/*/.azure*",
                    "*/home/*/.azure*",
                    "*/root/.azure*",
                    "*~*/.config*",
                    "*/Users/*/.config*",
                    "*/home/*/.config*",
                    "*/root/.config*",
                    "*~*/.claude*",
                    "*/Users/*/.claude*",
                    "*/home/*/.claude*",
                    "*/root/.claude*",
                    "*~*/.kiro/settings*",
                    "*/Users/*/.kiro/settings*",
                    "*/home/*/.kiro/settings*",
                    "*/root/.kiro/settings*",
                    "*~*/.kiro/sessions*",
                    "*/Users/*/.kiro/sessions*",
                    "*/home/*/.kiro/sessions*",
                    "*/root/.kiro/sessions*",
                    "*~*/.kiro/secrets*",
                    "*/Users/*/.kiro/secrets*",
                    "*/home/*/.kiro/secrets*",
                    "*/root/.kiro/secrets*",
                    "*~*/.local/share/kiro-cli*",
                    "*/Users/*/.local/share/kiro-cli*",
                    "*/home/*/.local/share/kiro-cli*",
                    "*/root/.local/share/kiro-cli*",
                    "*~*/Library/Application Support/kiro-cli*",
                    "*/Users/*/Library/Application Support/kiro-cli*",
                    "*/home/*/Library/Application Support/kiro-cli*",
                    "*/root/Library/Application Support/kiro-cli*",
                    "*~*/Library/Keychains*",
                    "*/Users/*/Library/Keychains*",
                    "*/home/*/Library/Keychains*",
                    "*/root/Library/Keychains*",
                    "*~*/.netrc*",
                    "*/Users/*/.netrc*",
                    "*/home/*/.netrc*",
                    "*/root/.netrc*",
                    "*~*/.git-credentials*",
                    "*/Users/*/.git-credentials*",
                    "*/home/*/.git-credentials*",
                    "*/root/.git-credentials*",
                    "*~*/.npmrc*",
                    "*/Users/*/.npmrc*",
                    "*/home/*/.npmrc*",
                    "*/root/.npmrc*",
                    "*~*/.pypirc*",
                    "*/Users/*/.pypirc*",
                    "*/home/*/.pypirc*",
                    "*/root/.pypirc*",
                    "*~*/.*_history*",
                    "*/Users/*/.*_history*",
                    "*/home/*/.*_history*",
                    "*/root/.*_history*",
                    "*$HOME*",
                    "*${HOME}*"
                ]
            },
            {
                "capability": "shell",
                "match": [
                    "*"
                ],
                "exclude": [
                    "cat",
                    "cat *",
                    "find",
                    "find *",
                    "grep",
                    "grep *",
                    "head",
                    "head *",
                    "ls",
                    "ls *",
                    "wc",
                    "wc *"
                ],
                "effect": "deny"
            },
            {
                "capability": "fs_write",
                "match": [
                    "**/documentacion_modernizacion/03_diseno_arquitectura_destino/**"
                ],
                "effect": "allow"
            },
            {
                "capability": "fs_write",
                "match": [
                    "**"
                ],
                "exclude": [
                    "**/documentacion_modernizacion/03_diseno_arquitectura_destino/**"
                ],
                "effect": "deny"
            },
            {
                "capability": "fs_read",
                "match": [
                    "~/.aws",
                    "~/.ssh",
                    "~/.gnupg",
                    "~/.kube",
                    "~/.docker",
                    "~/.azure",
                    "~/.config",
                    "~/.claude",
                    "~/.kiro/settings",
                    "~/.kiro/sessions",
                    "~/.local/share/kiro-cli",
                    "~/Library/Application Support/kiro-cli",
                    "~/Library/Keychains",
                    "~/.kiro/secrets*",
                    "~/.netrc",
                    "~/.git-credentials",
                    "~/.npmrc",
                    "~/.pypirc",
                    "~/.*_history"
                ],
                "effect": "deny"
            },
            {
                "capability": "fs_read",
                "effect": "allow"
            },
            {
                "capability": "mcp",
                "match": [
                    "aws-knowledge/*"
                ],
                "effect": "allow"
            }
        ]
    }
}
