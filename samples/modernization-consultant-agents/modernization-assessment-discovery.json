{
    "name": "modernization-assessment-discovery",
    "description": "Consultor de discovery: levanta una app legada (cualquier lenguaje) y produce el reporte de discovery & assessment legible para el cliente (inventario, deuda técnica, vulnerabilidades, métricas)",
    "model": "claude-opus-5.5",
    "tools": [
        "read",
        "shell",
        "write"
    ],
    "includeMcpJson": false,
    "prompt": "file://./consultant-modernization-assets/prompts/modernization-assessment-discovery.md",
    "welcomeMessage": "Consultor de Discovery & Assessment listo. Levanto la aplicación legada y produzco el reporte de estado, deuda técnica, vulnerabilidades y métricas, sin tocar el código de origen.",
    "permissions": {
        "rules": [
            {
                "capability": "shell",
                "match": [
                    "find *",
                    "find",
                    "grep *",
                    "grep",
                    "ls *",
                    "ls",
                    "cat *",
                    "cat",
                    "wc *",
                    "wc",
                    "head *",
                    "head",
                    "sort *",
                    "sort",
                    "uniq *",
                    "uniq"
                ],
                "effect": "allow"
            },
            {
                "capability": "shell",
                "effect": "deny",
                "match": [
                    "*`*",
                    "*$(*",
                    "find * -exec*",
                    "find * -ok*",
                    "find * -delete*",
                    "find * -fprint*",
                    "find * -fls*",
                    "find -exec*",
                    "find -execdir*",
                    "find -ok*",
                    "find -okdir*",
                    "find -delete*",
                    "find -fprint*",
                    "find -fls*",
                    "* .. *",
                    "* ../*",
                    "*/../*",
                    "* ..",
                    "*/..",
                    "*/..'*",
                    "*/..\"*",
                    "*=../*",
                    "*'..*",
                    "*\"..*",
                    "sort *-*o*",
                    "sort *-*T*",
                    "sort *--t*",
                    "uniq * *",
                    "*~*/.aws*",
                    "*/Users/*/.aws*",
                    "*/home/*/.aws*",
                    "*/root/.aws*",
                    "*~*/.ssh*",
                    "*/Users/*/.ssh*",
                    "*/home/*/.ssh*",
                    "*/root/.ssh*",
                    "*~*/.gnupg*",
                    "*/Users/*/.gnupg*",
                    "*/home/*/.gnupg*",
                    "*/root/.gnupg*",
                    "*~*/.kube*",
                    "*/Users/*/.kube*",
                    "*/home/*/.kube*",
                    "*/root/.kube*",
                    "*~*/.docker*",
                    "*/Users/*/.docker*",
                    "*/home/*/.docker*",
                    "*/root/.docker*",
                    "*~*/.azure*",
                    "*/Users/*/.azure*",
                    "*/home/*/.azure*",
                    "*/root/.azure*",
                    "*~*/.config*",
                    "*/Users/*/.config*",
                    "*/home/*/.config*",
                    "*/root/.config*",
                    "*~*/.claude*",
                    "*/Users/*/.claude*",
                    "*/home/*/.claude*",
                    "*/root/.claude*",
                    "*~*/.kiro/settings*",
                    "*/Users/*/.kiro/settings*",
                    "*/home/*/.kiro/settings*",
                    "*/root/.kiro/settings*",
                    "*~*/.kiro/sessions*",
                    "*/Users/*/.kiro/sessions*",
                    "*/home/*/.kiro/sessions*",
                    "*/root/.kiro/sessions*",
                    "*~*/.kiro/secrets*",
                    "*/Users/*/.kiro/secrets*",
                    "*/home/*/.kiro/secrets*",
                    "*/root/.kiro/secrets*",
                    "*~*/.local/share/kiro-cli*",
                    "*/Users/*/.local/share/kiro-cli*",
                    "*/home/*/.local/share/kiro-cli*",
                    "*/root/.local/share/kiro-cli*",
                    "*~*/Library/Application Support/kiro-cli*",
                    "*/Users/*/Library/Application Support/kiro-cli*",
                    "*/home/*/Library/Application Support/kiro-cli*",
                    "*/root/Library/Application Support/kiro-cli*",
                    "*~*/Library/Keychains*",
                    "*/Users/*/Library/Keychains*",
                    "*/home/*/Library/Keychains*",
                    "*/root/Library/Keychains*",
                    "*~*/.netrc*",
                    "*/Users/*/.netrc*",
                    "*/home/*/.netrc*",
                    "*/root/.netrc*",
                    "*~*/.git-credentials*",
                    "*/Users/*/.git-credentials*",
                    "*/home/*/.git-credentials*",
                    "*/root/.git-credentials*",
                    "*~*/.npmrc*",
                    "*/Users/*/.npmrc*",
                    "*/home/*/.npmrc*",
                    "*/root/.npmrc*",
                    "*~*/.pypirc*",
                    "*/Users/*/.pypirc*",
                    "*/home/*/.pypirc*",
                    "*/root/.pypirc*",
                    "*~*/.*_history*",
                    "*/Users/*/.*_history*",
                    "*/home/*/.*_history*",
                    "*/root/.*_history*",
                    "*$HOME*",
                    "*${HOME}*"
                ]
            },
            {
                "capability": "shell",
                "match": [
                    "*"
                ],
                "exclude": [
                    "cat",
                    "cat *",
                    "find",
                    "find *",
                    "grep",
                    "grep *",
                    "head",
                    "head *",
                    "ls",
                    "ls *",
                    "sort",
                    "sort *",
                    "uniq",
                    "uniq *",
                    "wc",
                    "wc *"
                ],
                "effect": "deny"
            },
            {
                "capability": "fs_write",
                "match": [
                    "**/documentacion_modernizacion/01_descubrimiento_evaluacion/**"
                ],
                "effect": "allow"
            },
            {
                "capability": "fs_write",
                "match": [
                    "**"
                ],
                "exclude": [
                    "**/documentacion_modernizacion/01_descubrimiento_evaluacion/**"
                ],
                "effect": "deny"
            },
            {
                "capability": "fs_read",
                "match": [
                    "~/.aws",
                    "~/.ssh",
                    "~/.gnupg",
                    "~/.kube",
                    "~/.docker",
                    "~/.azure",
                    "~/.config",
                    "~/.claude",
                    "~/.kiro/settings",
                    "~/.kiro/sessions",
                    "~/.local/share/kiro-cli",
                    "~/Library/Application Support/kiro-cli",
                    "~/Library/Keychains",
                    "~/.kiro/secrets*",
                    "~/.netrc",
                    "~/.git-credentials",
                    "~/.npmrc",
                    "~/.pypirc",
                    "~/.*_history"
                ],
                "effect": "deny"
            },
            {
                "capability": "fs_read",
                "effect": "allow"
            }
        ]
    }
}
