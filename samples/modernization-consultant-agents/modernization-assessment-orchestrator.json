{
    "name": "modernization-assessment-orchestrator",
    "description": "Orquesta el set consultor de modernización (discovery → arquitectura AS-IS → opciones de modernización) que produce el conocimiento legible para el cliente antes de tocar código",
    "model": "claude-sonnet-5",
    "tools": [
        "read",
        "shell",
        "subagent/modernization-assessment-current-architecture",
        "subagent/modernization-assessment-discovery",
        "subagent/modernization-assessment-target-architecture",
        "write"
    ],
    "includeMcpJson": false,
    "prompt": "file://./consultant-modernization-assets/prompts/modernization-assessment-orchestrator.md",
    "resources": [
        "file://.kiro/agents/consultant-modernization-assets/rules/*.md",
        "file://~/.kiro/agents/consultant-modernization-assets/rules/*.md"
    ],
    "welcomeMessage": "Orquestador consultor listo. Levanto la aplicación legada en tres fases (Discovery → AS-IS → Opciones de modernización) con documentos y diagramas para el cliente, sin tocar el código. Indícame la ruta de la aplicación a analizar.",
    "permissions": {
        "rules": [
            {
                "capability": "shell",
                "match": [
                    "mkdir -p *",
                    "mkdir -p",
                    "ls *",
                    "ls",
                    "find *",
                    "find",
                    "date *",
                    "date",
                    "pwd *",
                    "pwd",
                    "cat *",
                    "cat",
                    "grep *",
                    "grep",
                    "wc *",
                    "wc",
                    "head *",
                    "head",
                    "sort *",
                    "sort",
                    "uniq *",
                    "uniq"
                ],
                "effect": "allow"
            },
            {
                "capability": "shell",
                "effect": "deny",
                "match": [
                    "*`*",
                    "*$(*",
                    "find * -exec*",
                    "find * -ok*",
                    "find * -delete*",
                    "find * -fprint*",
                    "find * -fls*",
                    "find -exec*",
                    "find -execdir*",
                    "find -ok*",
                    "find -okdir*",
                    "find -delete*",
                    "find -fprint*",
                    "find -fls*",
                    "* .. *",
                    "* ../*",
                    "*/../*",
                    "* ..",
                    "*/..",
                    "*/..'*",
                    "*/..\"*",
                    "*=../*",
                    "*'..*",
                    "*\"..*",
                    "mkdir *.kiro*",
                    "sort *-*o*",
                    "sort *-*T*",
                    "sort *--t*",
                    "uniq * *",
                    "*~*/.aws*",
                    "*/Users/*/.aws*",
                    "*/home/*/.aws*",
                    "*/root/.aws*",
                    "*~*/.ssh*",
                    "*/Users/*/.ssh*",
                    "*/home/*/.ssh*",
                    "*/root/.ssh*",
                    "*~*/.gnupg*",
                    "*/Users/*/.gnupg*",
                    "*/home/*/.gnupg*",
                    "*/root/.gnupg*",
                    "*~*/.kube*",
                    "*/Users/*/.kube*",
                    "*/home/*/.kube*",
                    "*/root/.kube*",
                    "*~*/.docker*",
                    "*/Users/*/.docker*",
                    "*/home/*/.docker*",
                    "*/root/.docker*",
                    "*~*/.azure*",
                    "*/Users/*/.azure*",
                    "*/home/*/.azure*",
                    "*/root/.azure*",
                    "*~*/.config*",
                    "*/Users/*/.config*",
                    "*/home/*/.config*",
                    "*/root/.config*",
                    "*~*/.claude*",
                    "*/Users/*/.claude*",
                    "*/home/*/.claude*",
                    "*/root/.claude*",
                    "*~*/.kiro/settings*",
                    "*/Users/*/.kiro/settings*",
                    "*/home/*/.kiro/settings*",
                    "*/root/.kiro/settings*",
                    "*~*/.kiro/sessions*",
                    "*/Users/*/.kiro/sessions*",
                    "*/home/*/.kiro/sessions*",
                    "*/root/.kiro/sessions*",
                    "*~*/.kiro/secrets*",
                    "*/Users/*/.kiro/secrets*",
                    "*/home/*/.kiro/secrets*",
                    "*/root/.kiro/secrets*",
                    "*~*/.local/share/kiro-cli*",
                    "*/Users/*/.local/share/kiro-cli*",
                    "*/home/*/.local/share/kiro-cli*",
                    "*/root/.local/share/kiro-cli*",
                    "*~*/Library/Application Support/kiro-cli*",
                    "*/Users/*/Library/Application Support/kiro-cli*",
                    "*/home/*/Library/Application Support/kiro-cli*",
                    "*/root/Library/Application Support/kiro-cli*",
                    "*~*/Library/Keychains*",
                    "*/Users/*/Library/Keychains*",
                    "*/home/*/Library/Keychains*",
                    "*/root/Library/Keychains*",
                    "*~*/.netrc*",
                    "*/Users/*/.netrc*",
                    "*/home/*/.netrc*",
                    "*/root/.netrc*",
                    "*~*/.git-credentials*",
                    "*/Users/*/.git-credentials*",
                    "*/home/*/.git-credentials*",
                    "*/root/.git-credentials*",
                    "*~*/.npmrc*",
                    "*/Users/*/.npmrc*",
                    "*/home/*/.npmrc*",
                    "*/root/.npmrc*",
                    "*~*/.pypirc*",
                    "*/Users/*/.pypirc*",
                    "*/home/*/.pypirc*",
                    "*/root/.pypirc*",
                    "*~*/.*_history*",
                    "*/Users/*/.*_history*",
                    "*/home/*/.*_history*",
                    "*/root/.*_history*",
                    "*$HOME*",
                    "*${HOME}*"
                ]
            },
            {
                "capability": "shell",
                "match": [
                    "*"
                ],
                "exclude": [
                    "cat",
                    "cat *",
                    "date",
                    "date *",
                    "find",
                    "find *",
                    "grep",
                    "grep *",
                    "head",
                    "head *",
                    "ls",
                    "ls *",
                    "mkdir -p",
                    "mkdir -p *",
                    "pwd",
                    "pwd *",
                    "sort",
                    "sort *",
                    "uniq",
                    "uniq *",
                    "wc",
                    "wc *"
                ],
                "effect": "deny"
            },
            {
                "capability": "fs_write",
                "match": [
                    "**/documentacion_modernizacion/**"
                ],
                "effect": "allow"
            },
            {
                "capability": "fs_write",
                "match": [
                    "**"
                ],
                "exclude": [
                    "**/documentacion_modernizacion/**"
                ],
                "effect": "deny"
            },
            {
                "capability": "mcp",
                "match": [
                    "aws-knowledge/*"
                ],
                "effect": "allow"
            },
            {
                "capability": "subagent",
                "match": [
                    "modernization-assessment-current-architecture",
                    "modernization-assessment-discovery",
                    "modernization-assessment-target-architecture"
                ],
                "effect": "allow"
            },
            {
                "capability": "fs_read",
                "match": [
                    "~/.aws",
                    "~/.ssh",
                    "~/.gnupg",
                    "~/.kube",
                    "~/.docker",
                    "~/.azure",
                    "~/.config",
                    "~/.claude",
                    "~/.kiro/settings",
                    "~/.kiro/sessions",
                    "~/.local/share/kiro-cli",
                    "~/Library/Application Support/kiro-cli",
                    "~/Library/Keychains",
                    "~/.kiro/secrets*",
                    "~/.netrc",
                    "~/.git-credentials",
                    "~/.npmrc",
                    "~/.pypirc",
                    "~/.*_history"
                ],
                "effect": "deny"
            },
            {
                "capability": "fs_read",
                "effect": "allow"
            }
        ]
    }
}
